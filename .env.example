# ============================================================================
# Marketing Knowledge Garden — env template (v0.3)
# Copy to `.env` (or `.env.local` for Next.js) and fill in real values.
# NEVER commit a populated .env. .gitignore must contain it.
#
# v0.3 notes:
#   * NEW dedicated Supabase project: rojpjtyjiapqpsxdeovk (us-east-2)
#   * Old umbrella vars preserved for cross-project reads (brand assets etc.)
#     but the MKG product DB is now NEW_SUPABASE_*.
#   * Stripe vars added — Cycle 003 prioritizes revenue.
# ============================================================================

# ---------------- Supabase: NEW dedicated MKG project ----------------
NEW_SUPABASE_URL=https://rojpjtyjiapqpsxdeovk.supabase.co
NEW_SUPABASE_ANON_KEY=                              # paste from Supabase dashboard > API
NEW_SUPABASE_SERVICE_ROLE_KEY=                      # server-only; never ship to client
NEW_SUPABASE_JWT_SECRET=                            # for verifying server-side JWTs
NEW_SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.rojpjtyjiapqpsxdeovk.supabase.co:5432/postgres

# Convenience aliases for Next.js client — point at the NEW project.
NEXT_PUBLIC_SUPABASE_URL=https://rojpjtyjiapqpsxdeovk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                      # same as NEW_SUPABASE_ANON_KEY

# ---------------- Supabase: legacy umbrella (read-only references) ----------------
# Used only when the MKG needs to read shared umbrella assets/lists.
# The MKG product DB is the NEW_SUPABASE_* project above.
UMBRELLA_SUPABASE_URL=https://vlezoyalutexenbnzzui.supabase.co
UMBRELLA_SUPABASE_ANON_KEY=                         # read-only access to brand-assets etc.

# ---------------- Stripe (Cycle 003 — revenue) ----------------
STRIPE_PUBLIC_KEY=                                  # pk_live_... or pk_test_...
STRIPE_SECRET_KEY=                                  # sk_live_... or sk_test_...; server-only
STRIPE_WEBHOOK_SECRET=                              # whsec_... for webhook signature verification
STRIPE_PRICE_ID_STARTER=                            # set when products are created in Stripe
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# ---------------- GitHub ----------------
GITHUB_REPO=knowledge-gardens-marketing
GITHUB_OWNER=
GITHUB_PAT=
GITHUB_DEFAULT_BRANCH=main

# ---------------- Vercel ----------------
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
VERCEL_TOKEN=
VERCEL_DEPLOY_HOOK_URL=

# ---------------- Domain ----------------
PUBLIC_URL=https://marketing.theknowledgegardens.com

# ---------------- LLM providers ----------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=                                 # optional, for citation health checks
GOOGLE_AI_API_KEY=                                  # optional, for Gemini citation checks

# ---------------- Embeddings ----------------
EMBEDDING_MODEL=text-embedding-3-small              # vector(1536) is sized for these

# ---------------- Citation health test ----------------
CITATION_TEST_QUERIES_PATH=data/citation-baseline-canonical-questions.txt
CITATION_TEST_BUCKET=citation-tests

# ---------------- Architect runtime ----------------
ARCHITECT_CYCLE_ID=cycle-003
ARCHITECT_SESSION_NAME=cowork                       # 'cowork' | 'claude_code' | 'cron'
ARCHITECT_NOTIFY_WEBHOOK=                           # optional, for dispatch-report posting

# ---------------- Optional: external martech APIs ----------------
CRUNCHBASE_API_KEY=
SIMILARWEB_API_KEY=
